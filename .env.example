# Site
NEXT_PUBLIC_SITE_URL=https://www.inukaproperties.co.ke

# Private admin URL — never linked on the public website. Share only with your team.
# When set, /admin returns 404; use your custom path to sign in (e.g. /iapl-manage-7k9x/login).
ADMIN_PATH=/iapl-manage-7k9x
NEXT_PUBLIC_ADMIN_PATH=/iapl-manage-7k9x

# Supabase — create a project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: service role for server-side admin operations (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications (Resend — https://resend.com)
RESEND_API_KEY=re_your_api_key
NOTIFY_EMAIL=admin@inukaproperties.co.ke
EMAIL_FROM=IAPL Admin <notifications@inukaproperties.co.ke>

# Webhook secret for Supabase database webhooks → /api/webhooks/notify
WEBHOOK_SECRET=your-random-secret

# Admin login email verification (encrypts pending sessions; can reuse WEBHOOK_SECRET)
ADMIN_LOGIN_SECRET=your-random-secret

# Google Places (existing)
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
