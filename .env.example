# =============================================================================
# INUKA AFRIKA PROPERTIES — Environment template
# Copy to .env.local for local dev. Set the same keys in Vercel for production.
# =============================================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.inukaproperties.co.ke

# --- Admin URL (secret path — not linked on public site) ---
ADMIN_PATH=/iapl-manage-7k9x
NEXT_PUBLIC_ADMIN_PATH=/iapl-manage-7k9x

# --- Supabase (Dashboard → Project Settings → API) ---
# Set BOTH public (client/build) and server names on Vercel for reliable API routes.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# --- Admin login email verification ---
ADMIN_LOGIN_SECRET=generate-a-long-random-string

# --- Resend (https://resend.com) ---
RESEND_API_KEY=re_your_api_key
NOTIFY_EMAIL=admin@inukaproperties.co.ke
EMAIL_FROM=IAPL Admin <notifications@inukaproperties.co.ke>

# --- WhatsApp lead alerts (optional — admin number 0711 082 084) ---
# Meta WhatsApp Cloud API (recommended for automatic admin alerts):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Bulk SMS — Okay SMS International (https://my.okaysms.com) ---
SMS_PROVIDER=okaysms
OKAYSMS_API_URL=https://my.okaysms.com/api/http
OKAYSMS_API_KEY=
SMS_API_KEY=
SMS_SENDER_ID=INUKA

# Other providers (optional):
# SMS_PROVIDER=africas_talking
# AFRICAS_TALKING_USERNAME=
# AFRICAS_TALKING_API_KEY=
# SMS_PROVIDER=celcom
# CELCOM_PARTNER_ID=
# CELCOM_SHORTCODE=

# --- Webhooks (optional) ---
WEBHOOK_SECRET=your-random-secret

# --- IAPL Ticketing — inbound email (Resend Inbound) ---
# Resend receiving address: anything@weugei.resend.app (wildcard on your Resend inbound domain)
TICKETS_INBOUND_EMAIL=tickets@weugei.resend.app
NEXT_PUBLIC_TICKETS_INBOUND_EMAIL=tickets@weugei.resend.app

# --- Google Places ---
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
